# ==============================================================================
# NATIONAL FLOOD DISASTER RESPONSE SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Settings
PROJECT_NAME="Agentic AI Based Autonomous Flood Disaster Response and Rescue Coordination System"
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration:
# - SQLite (Zero-config local development): sqlite+aiosqlite:///./flood_response.db
# - PostgreSQL (Production / Docker): postgresql+asyncpg://ndma_admin:<password>@localhost:5432/flood_disaster_db
DATABASE_URL=sqlite+aiosqlite:///./flood_response.db

# Agent Execution Engine:
# - 'autonomous' : Uses deterministic rule & NLP heuristic multi-agent engine (100% offline, zero API keys required)
# - 'crewai'     : Uses official CrewAI orchestration with OpenAI / Groq / Ollama LLM backend
AI_ENGINE_MODE=autonomous

# Optional LLM Key (Only required if AI_ENGINE_MODE=crewai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# PostgreSQL Container Credentials (Used by Docker Compose)
POSTGRES_USER=ndma_admin
POSTGRES_PASSWORD=
POSTGRES_DB=flood_disaster_db
